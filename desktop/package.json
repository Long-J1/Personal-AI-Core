{
  "name": "personal-ai-desktop",
  "productName": "Personal AI",
  "version": "0.2.0",
  "description": "Personal AI Core 桌面外壳——身体与入口（Core 是灵魂）",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.personalai.core",
    "productName": "Personal AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "*.html"
    ],
    "extraResources": [
      {
        "from": "build/core",
        "to": "core"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "PersonalAI-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Personal AI",
      "deleteAppDataOnUninstall": false
    }
  }
}
